{
  "$id": "user.json",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "users",
  "type": "object",
  "properties": {
    "traits": {
      "type": "object",
      "properties": {
        "username": {
          "type": "string",
          "title": "Username"
        },
        "name": {
          "title": "Name",
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email",
          "title": "E-Mail",
          "minLength": 3,
          "ory.sh/kratos": {
            "credentials": {
              "password": {
                "identifier": true
              },
              "totp": {
                "account_name": true
              }
            },
            "verification": {
              "via": "email"
            },
            "recovery": {
              "via": "email"
            }
          }
        },
        "phone_number": {
          "type": "string",
          "title": "Phone Number"
        },
        "invite_status": {
          "type": "string",
          "title": "Invite Status"
        },
        "invited_by": {
          "type": "string",
          "title": "Invited By"
        },
        "img_url": {
          "type": "string",
          "title": "Profile Image URL"
        },
        "role": {
          "type": "string",
          "title": "Role"
        },
        "created_at": {
          "type": "string",
          "title": "Created At"
        },
        "github_id": {
          "type": "string",
          "title": "Github ID"
        },
        "totp_enabled": {
          "type": "boolean",
          "title": "Whether user has enabled totp"
        }
      },

      "required": [
        "username",
        "email",
        "name",
        "phone_number",
        "role",
        "invite_status",
        "created_at",
        "totp_enabled"
      ],
      "additionalProperties": false
    }
  }
}
